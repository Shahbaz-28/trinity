# v0 runtime files
__v0_runtime_loader.js
__v0_devtools.tsx
__v0_jsx-dev-runtime.ts

# Common ignores
node_modules
.next/
.DS_Store

# Env files — never commit real secrets. .env.local.example is intentionally
# NOT matched here (it's the template, safe to commit).
.env
.env*.local
.env.production

# TypeScript / Next build artifacts (auto-regenerated)
*.tsbuildinfo
next-env.d.ts

# Vercel (created by `vercel` CLI once you deploy)
.vercel

# Supabase CLI local cache (regenerated by `supabase link`/`supabase init`)
supabase/.temp
supabase/.branches